# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=second_brain
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
LOG_DIR=logs

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_OLLAMA=3
MAX_TOKENS=1500
MAX_TOKENS_OLLAMA=600

# ── Retry ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# ── JWT (generate a long random string for production!) ──────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM API Keys (fill in the one you use) ───────────────────────────────────
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...
# COHERE_API_KEY=...
# TOGETHER_API_KEY=...