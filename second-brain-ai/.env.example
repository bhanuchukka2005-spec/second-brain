# Copy to .env and fill in your values. Never commit .env to git.

# App
DEBUG=false
LOG_LEVEL=INFO

# Storage
DB_PATH=data/sessions.db
UPLOAD_DIR=data/uploads
LOG_DIR=logs

# RAG Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_OLLAMA=3
MAX_TOKENS=1500
MAX_TOKENS_OLLAMA=600

# Retry
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# JWT (change this in production!)
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys (fill in the one you use)
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
